# Copy this file to `.env` and replace both values with unique, strong passwords.
# Never commit the resulting `.env` file.
POSTGRES_PASSWORD=replace-with-a-strong-superuser-password
POSTGRES_APP_PASSWORD=replace-with-a-strong-application-password
# Optional: reuse a local Hugging Face hub cache for the embedding model.
# HF_HUB_CACHE_SOURCE=/absolute/path/to/.cache/huggingface/hub
# HF_HUB_OFFLINE=1
# HF_TOKEN=your-hugging-face-token-if-a-download-is-required

# Choose one answer provider. Retrieved authorised text is sent to that provider.
# LLM_PROVIDER=gpt
# OPENAI_API_KEY=your-openai-api-key
# LLM_PROVIDER=deepseek
# DEEPSEEK_API_KEY=your-deepseek-api-key
